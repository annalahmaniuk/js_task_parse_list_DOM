"use strict";
window.addEventListener("DOMContentLoaded", function() {
    var ul = document.querySelector("ul");
    sortList(ul);
    getEmployees(ul);
});
function sortList(list) {
    var selector = Array.from(list.querySelectorAll("li"));
    var sortSalary = selector.sort(function(a, b) {
        var salaryA = parseSalary(a.dataset.salary);
        var salaryB = parseSalary(b.dataset.salary);
        return salaryB - salaryA;
    });
    list.innerHTML = "";
    sortSalary.forEach(function(item) {
        return list.append(item);
    });
}
function parseSalary(salaryStr) {
    return Number(salaryStr.replace(/[$,]/g, ""));
}
function getEmployees(list) {
    var selector = Array.from(list.querySelectorAll("li"));
    return selector.map(function(li) {
        return {
            name: li.textContent.trim()
        };
    });
}

